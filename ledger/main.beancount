option "title" "Bookkeeper"
option "operating_currency" "USD"

include "accounts.beancount"

; Generated by `bookkeeper sync` (worker-1 / bookkeeper.ingest): `open`
; directives for Assets:SimpleFIN:<Name> accounts, one per synced bank
; account. Owned and rewritten by bookkeeper.ingest — accounts.beancount
; above stays hand-curated for expense/envelope accounts only, so nobody
; has to hand-open an account per bank connection.
include "accounts-simplefin.beancount"

include "budget.beancount"

; Generated by `bookkeeper sync` (worker-1 / bookkeeper.ingest). The
; placeholder file below keeps this glob resolvable before the first real
; sync has run; real dated files land alongside it.
include "transactions/*.beancount"

; Generated by `bookkeeper sync` — SimpleFIN `balance`/`balance-date` per
; account, rendered as beancount `balance` assertions.
include "balances.beancount"
