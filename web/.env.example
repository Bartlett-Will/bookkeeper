# generate a random secret: `openssl rand -base64 32`
# Required — NextAuth throws at startup without it, even though this app
# has no login flow (see app/(auth)/auth.ts).
AUTH_SECRET=****

# Local Ollama instance (PLAN.md §5.3, §5.6). No API key: Ollama doesn't
# require one for local instances, and this app never falls back to a
# hosted provider if Ollama is unreachable.
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=qwen3:8b

# SQLite file path (Drizzle). Replaces Neon Postgres — see PLAN.md §5.6.
SQLITE_URL=./data/local.db

# Python sidecar (FastAPI), the sole ledger writer — see PLAN.md §4, §9.
SIDECAR_BASE_URL=http://127.0.0.1:8000

# Optional. Only enables cross-request stream resumption (lib/ratelimit.ts,
# app/(chat)/api/chat/route.ts); the app works fully without it. Leave unset
# on a single-user localhost box.
# REDIS_URL=****
